{
  "name": "mern-app",
  "version": "1.0.0",
  "description": "MERN Stack Project Boilerplate",
  "main": "server/server.js",
  "scripts": {
    "build": "npm run build --prefix client",
    "vercel-build": "npm install --prefix server && npm install --prefix client && npm run build --prefix client",
    "server": "npm start --prefix server",
    "server:dev": "npm run dev --prefix server",
    "client": "npm run dev --prefix client",
    "dev": "concurrently \"npm run server:dev\" \"npm run client\"",
    "install-all": "npm install --prefix server && npm install --prefix client"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.3.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
